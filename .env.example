
# Supabase Configuration for WUP Registrar System
# Find these in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-or-anon-key-here
PORT=3000

# EmailJS (MailJS) configuration for OTP password recovery
# Sign up at https://www.emailjs.com/
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here

# SMS Gateway Configuration (select 'iprog' or 'semaphore')
SMS_PROVIDER=iprog

# iProg SMS Configuration (Philippine SMS gateway: https://iprogsms.com)
IPROG_API_TOKEN=your_iprog_api_token_here

# Semaphore SMS Configuration (alternative: https://semaphore.co)
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=

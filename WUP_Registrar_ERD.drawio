TEXT&lt;/span&gt; &lt;span style=&quot;color:#475569;&quot;&gt;Parent Request Ref (links to requests.ref)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#ffffff;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:5px 8px;white-space:nowrap;font-weight:600;color:#1e293b;&quot;&gt;name&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;color:#64748b;font-size:10px;&quot;&gt;&lt;span style=&quot;color:#0f766e;font-family:monospace;font-size:9.5px;&quot;&gt;TEXT&lt;/span&gt; &lt;span style=&quot;color:#475569;&quot;&gt;Document name (e.g. Transcript of Records)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;border-bottom:1px solid #e2e8f0;&quot;&gt;&lt;td style=&quot;padding:5px 8px;white-space:nowrap;font-weight:600;color:#1e293b;&quot;&gt;copies&lt;/td&gt;&lt;td style=&quot;padding:5px 8px;color:#64748b;font-size:10px;&quot;&gt;&lt;span style=&quot;color:#0f766e;font-family:monospace;font-size:9.5px;&quot;&gt;INTEGER&lt;/span&gt; &lt;span style=&quot;color:#475569;&quot;&gt;Number of copies requested (e.g. 1, 2)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#ffffff;strokeColor=#0d9488;strokeWidth=2;shadow=1;overflow=hidden;" vertex="1" parent="1">

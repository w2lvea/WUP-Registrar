        <mxCell id="proc_2" value="&lt;div style=&quot;font-family:&apos;Segoe UI&apos;,Roboto,Helvetica,sans-serif;height:100%;background:#ffffff;border-radius:12px;border:2.5px solid #d97706;overflow:hidden;box-shadow:0 4px 10px rgba(217,119,6,0.12);&quot;&gt;
